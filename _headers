# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Long cache for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=31536000, immutable

/laborday2026/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS and JS — short cache so updates ship quickly
/*.css
  Cache-Control: public, max-age=300, must-revalidate

/*.js
  Cache-Control: public, max-age=300, must-revalidate

# HTML — always revalidate so new deploys are seen instantly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Text versions for AI agents. The homepage itself (/) runs through
# functions/_middleware.js, which sets its own headers.
/index.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Link: <https://griffinmiller.com/>; rel="canonical"

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

# Sensible defaults for everything else
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
